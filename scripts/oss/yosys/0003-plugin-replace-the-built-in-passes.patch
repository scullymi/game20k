From 8d39fbebcaf2aecc09039685d631e132d6d21a8b Mon Sep 17 00:00:00 2001
From: scullymi <github@twork.de>
Date: Mon, 26 Oct 2026 07:27:16 +0100
Subject: [PATCH 3/3] plugin: replace the built-in passes

For the plugin build only. Backend::run_register refuses a second backend of the same name even when replace_existing_pass() is true, so XAigerBackend registers itself.
---
 backends/aiger/xaiger.cc   | 2 ++
 passes/hierarchy/submod.cc | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/backends/aiger/xaiger.cc b/backends/aiger/xaiger.cc
index 7eb2a5f1c..f6b98bd6c 100644
--- a/backends/aiger/xaiger.cc
+++ b/backends/aiger/xaiger.cc
@@ -725,6 +725,8 @@ struct XAigerWriter
 
 struct XAigerBackend : public Backend {
 	XAigerBackend() : Backend("xaiger", "write design to XAIGER file") { }
+	// Plugin build only: replaces the built-in backend, since Backend::run_register refuses a second one
+	void run_register() override { pass_register[pass_name] = this; backend_register[backend_name] = this; }
 	void help() override
 	{
 		//   |---v---|---v---|---v---|---v---|---v---|---v---|---v---|---v---|---v---|---v---|
diff --git a/passes/hierarchy/submod.cc b/passes/hierarchy/submod.cc
index 7cd5e33f6..002e174a2 100644
--- a/passes/hierarchy/submod.cc
+++ b/passes/hierarchy/submod.cc
@@ -320,6 +320,8 @@ struct SubmodWorker
 
 struct SubmodPass : public Pass {
 	SubmodPass() : Pass("submod", "moving part of a module to a new submodule") { }
+	// Plugin build only: replaces the built-in pass
+	bool replace_existing_pass() const override { return true; }
 	void help() override
 	{
 		//   |---v---|---v---|---v---|---v---|---v---|---v---|---v---|---v---|---v---|---v---|
-- 
