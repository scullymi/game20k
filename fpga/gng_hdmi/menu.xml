<?xml version="1.0" encoding="utf-8"?>
<!-- Ghosts'n Goblins (game20k) configuration for the FPGA Companion. -->
<config name="GnG" version="0">
  <actions>
    <!-- game20k: deliberately WITHOUT commands. The Pico answers these four
         buttons itself (menu.c catches them by name) and does not pass them on
         to the core. They must be listed all the same: config_get_action()
         resolves an unknown name to NULL, and the button then does nothing. -->
    <action name="netinfo"/>
    <action name="rainfo"/>
    <action name="verinfo"/>
    <action name="ralist"/>
    <action name="init">
      <load file="gng.ini"/>
      <set id="R" value="1"/>
    </action>
    <action name="ready">
      <set id="R" value="0"/>
    </action>
    <action name="save">
      <save file="gng.ini"/>
    </action>
    <action name="reset">
      <set id="R" value="1"/>
      <delay ms="10"/>
      <set id="R" value="0"/>
    </action>
    <action name="reset_hide">
      <link action="reset"/>
      <hide/>
    </action>
  </actions>

  <menu label="Ghosts'n Goblins">
    <!-- game20k: the values are the raw DSW1 and DSW2 bits of MAME gng.cpp, the wrapper
         only places them. Every list resets: the switches reach the core only in reset.
         The defaults are MAME's and jotego's (DF, FB). -->
    <menu label="DIP switches">
      <list label="Difficulty:" id="F" default="3" action="reset">
        <listentry label="Easy" value="2"/>
        <listentry label="Normal" value="3"/>
        <listentry label="Difficult" value="1"/>
        <listentry label="Very difficult" value="0"/>
      </list>
      <list label="Lives:" id="L" default="3" action="reset">
        <listentry label="3" value="3"/>
        <listentry label="4" value="2"/>
        <listentry label="5" value="1"/>
        <listentry label="7" value="0"/>
      </list>
      <list label="Bonus:" id="B" default="3" action="reset">
        <listentry label="20K 70K +70K" value="3"/>
        <listentry label="30K 80K +80K" value="2"/>
        <listentry label="20K 80K" value="1"/>
        <listentry label="30K 80K" value="0"/>
      </list>
      <list label="Coinage:" id="C" default="15" action="reset">
        <listentry label="1C/1C" value="15"/>
        <listentry label="1C/2C" value="14"/>
        <listentry label="1C/3C" value="13"/>
        <listentry label="1C/4C" value="12"/>
        <listentry label="1C/5C" value="11"/>
        <listentry label="1C/6C" value="10"/>
        <listentry label="1C/7C" value="9"/>
        <listentry label="2C/1C" value="8"/>
        <listentry label="2C/3C" value="7"/>
        <listentry label="2C/5C" value="6"/>
        <listentry label="3C/1C" value="5"/>
        <listentry label="3C/2C" value="4"/>
        <listentry label="3C/4C" value="3"/>
        <listentry label="4C/1C" value="2"/>
        <listentry label="4C/3C" value="1"/>
        <listentry label="Free play" value="0"/>
      </list>
      <list label="Demo sounds:" id="E" default="0" action="reset">
        <listentry label="On" value="0"/>
        <listentry label="Off" value="1"/>
      </list>
      <!-- jotego's core option: the arcade's palette writes during the picture make
           yellow flashes, On blocks them -->
      <list label="Block flashes:" id="Y" default="0" action="reset">
        <listentry label="Off" value="0"/>
        <listentry label="On" value="1"/>
      </list>
    </menu>
    <menu label="Controller">
      <list label="Fire:" id="A" default="1">
        <listentry label="Any" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Jump:" id="K" default="2">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Coin:" id="N" default="9">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Start 1P:" id="P" default="10">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Start 2P:" id="Q" default="0">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Vol -:" id="D" default="0">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Vol +:" id="U" default="0">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Input test:" id="T" default="0">
        <listentry label="Off" value="0"/>
        <listentry label="On" value="1"/>
      </list>
    </menu>
    <menu label="Settings">
      <image label="ROM set" index="0" ext="rom" default="gng.rom"
             none_str="&lt;none&gt;" action="reset_hide"/>
      <list label="Volume:" id="V" default="6">
        <listentry label="Off" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7 (max)" value="7"/>
      </list>
      <list label="Scanlines:" id="S" default="0">
        <listentry label="Off" value="0"/>
        <listentry label="25%" value="1"/>
        <listentry label="50%" value="2"/>
        <listentry label="75%" value="3"/>
      </list>
      <button label="Save settings" action="save"/>
    </menu>
    <!-- game20k: the mode goes to the core like any value and the core ignores
         'H'. The Pico follows it (sys_set_val): softcore applies at once, hardcore
         resets a running game first, as RetroAchievements asks. Hardcore is the
         default, as RetroAchievements recommends. The Pico answers the two buttons
         itself: the list of achievements and the account, see Status below. -->
    <menu label="RetroAchievements">
      <list label="Mode:" id="H" default="1">
        <listentry label="Softcore" value="0"/>
        <listentry label="Hardcore" value="1"/>
      </list>
      <button label="Achievements" action="ralist"/>
      <button label="Account" action="rainfo"/>
    </menu>
    <!-- game20k: display only. The Pico answers these buttons itself (menu.c
         catches the actions), they do NOT go to the core. The OSD is 64 pixels
         high and holds exactly four entries, no room for a line that is always
         visible, so it is shown on request. -->
    <menu label="Status">
      <button label="Network" action="netinfo"/>
      <button label="Version" action="verinfo"/>
    </menu>
    <button label="Reset" action="reset_hide"/>
  </menu>
</config>
