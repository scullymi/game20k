# ROM manifest of Jr. Pac-Man on the Pac-Man board. The format is described in the head of
# pacman.manifest, the section options here are:
#   zeros             no chips, the section's bytes are 0
#   sdram             the section goes to SDRAM bank 2 at its file offset (rom_sdram.sv),
#                     not to the core's write port
#   decrypt=jrpacman  MAME's table for the PALs on the board, over the CPU's address space
#                     (make_rom.py, JRPACMAN_XOR)
#
# One bitstream runs Pac-Man, Ms. Pac-Man and Jr. Pac-Man, and rom_loader has one section
# table. So this file starts with mspacman.rom's layout (sections 0 to 6), and build.tcl
# writes the table from this manifest. Of those seven, Jr. uses two: gfx takes the tiles (2c),
# the first half of Jr.'s 16 KB graphics, at the same place as Pac-Man's, and timing_3m the
# timing PROM 5s (the same chip as 3m, in the file for the digest only). The others are zeros.
#
# Jr.'s own sections follow. The program goes to SDRAM (CPU 0x0000-0x3FFF and 0x8000-0xDFFF
# without the gap), decrypted with MAME's table (decrypt=jrpacman). The core sees its first
# byte and switches to Jr. Pac-Man (mod_jr), see game_core.sv. Then the sprites (2e), the
# second half of the graphics, and the PROMs in the order of MiSTer's Jr. Pac-Man.mra: 2e goes
# to the download addresses 0xC000-0xDFFF, where the core's Pac-Man PROM decoder also listens,
# 9e and 9f as well, so the colour table 9p and the wave PROM 7p must come last.

set     jrpacman
title   Jr. Pac-Man (Bally Midway)
zip     jrpacman.zip
total   91936
board   2
mirror  6272
# MAME ROT90, as Pac-Man
screen  cw
# the file make_rom.py builds from roms/jrpacman.zip, the candidate for the firmware's digest list
known   299e5ffbf28c7ecf70a72012a1a6f6612cb2fbf45bae93ae49353d615df66b0e MAME jrpacman

section program     0x0000 16384 zeros
section gfx         0x4000 8192
chip    jr.pac-man_2c_11-9-83.2c 8192 37fe3176b0d125b7d629e108e7ebdc1196e4a132
section palette_7f  0x6000 32 zeros
section colour_4a   0x6020 256 zeros
section wave_1m     0x6120 256 zeros
section timing_3m   0x6220 256
chip    a290-27axv-exhd.5s 256 0c4d0bee858b97632411c440bea6948a74759746
section bank1       0x6320 16384 zeros
section jr_program  0xA320 40960 sdram decrypt=jrpacman
chip    jr.pac-man_8d_11-9-83.8d 8192 5ea34621213c649ca2848ab31aab2cbe751723d4
chip    jr.pac-man_8e_11-9-83.8e 8192 8294e9e79f8fd19a419431fa690e6ac4a1302f58
chip    jr.pac-man_8h_11-9-83.8h 8192 b84b34560b9aae18b24274712b052283faa01730
chip    jr.pac-man_8j_11-9-83.8j 8192 07d912a61824323c8fc1b8bd0da89172d4f70b91
chip    jr.pac-man_8k_11-9-83.8k 8192 18bd4d5381656120e4242811006c20776774de4d
section jr_gfx_hi   0x14320 8192
chip    jr.pac-man_2e_11-9-83.2e 8192 f00a488958ea0438642d345693787bdf771219ad
section jr_pal_9e   0x16320 256
chip    a290-27axv-bxhd.9e 256 d9aa2dc442e9ac36cf3c346b9fb1aa745eaf3cb8
section jr_pal_9f   0x16420 256
chip    a290-27axv-cxhd.9f 256 7561f8ccab2af85c111af6a02af6986eb67503e5
section jr_col_9p   0x16520 256
chip    a290-27axv-axhd.9p 256 62cf15513934d34641433c891a7f73bef82e2fb1
section jr_wave_7p  0x16620 256
chip    a290-27axv-dxhd.7p 256 bbcec0570aeceb582ff8238a4bc8546a23430081
