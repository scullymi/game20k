# ROM manifest of Pac-Man with the speedup hack (MAME clone pacmanf of puckman). The layout is
# pacman.manifest's, see there: pacfast.6f takes the place of pacman.6f, the rest as in
# pacman. The merged puckman.zip holds all its chips.

set     pacmanf
title   Pac-Man (Midway, speedup hack)
zip     puckman.zip
total   25376
board   2
mirror  6272
screen  cw
# the file make_rom.py builds from roms/puckman.zip, the candidate for the firmware's digest list
known   a15e0aca973d1fa470735948799fca15ab97b3b5bd3785c4d926566092bfce3e MAME pacmanf
# RetroAchievements lists the speedup hack as a game of its own, with Pac-Man's switches.
ra      24885
short   Pac-Man (speedup)
dip     L 2
dip     C 1

section program     0x0000 16384
chip    pacman.6e   4096 e87e059c5be45753f7e9f33dff851f16d6751181
chip    pacfast.6f  4096 7224d7acfa0144b681c71d7734a7337189835361
chip    pacman.6h   4096 8e47e8c2c4d6117d174cdac150392042d3e0a881
chip    pacman.6j   4096 d4a70d56bb01d27d094d73db8667ffb00ca69cb9
section gfx         0x4000 8192
