# ROM manifest of Galaga: which chips of the MAME set go where in galaga.rom, the one file
# the Companion streams from the SD card into the core. This is the only place the layout is
# written down. Three things are made from it:
#   scripts/make_rom.py         builds sdcard/galaga.rom from roms/, checking every chip
#   build.tcl                   the section table of rom_loader, the board id and the mirror
#                               size (gen/rom_map_pkg.sv)
#   scripts/make_fw_tables.py   the set's row in the firmware's game table, from the board,
#                               known, ra, short and dip lines
#
# Format: one entry per line, words separated by blanks, # starts a comment.
#   set <name>        MAME set name. The file on the card is <name>.rom, the settings <name>.ini
#   title <text>      shown by the scripts
#   zip <file>        the set in roms/, as a MAME merged set
#   total <bytes>     size of the finished file, rom_loader accepts exactly this size
#   board <id>        which board this core is to the firmware, 1..254: header byte 12 of
#                     the RAM mirror (BOARD_ID)
#   mirror <bytes>    game RAM bytes in the RAM mirror before the oracle log (MIRROR_DATA), a
#                     multiple of 128 and at most 22528; header byte 14 = mirror / 128
#   screen upright|cw|ccw
#                     how the core's raster stands: upright on a landscape monitor, or turned
#                     for a portrait monitor clockwise (cw) or counter-clockwise (ccw). The
#                     core decides, MAME's ROT90 and ROT270 are only a hint. The files of a
#                     board share it, unless they carry it in a header section (1942.manifest)
#   section <name> <offset> <bytes>
#                     one ROM memory of the core. Sections follow each other in file order,
#                     offsets on 256-byte boundaries, which is why the 32-byte PROM comes last.
#   chip <file> <bytes> <SHA-1> [zip=<file>] [optional]
#                     one chip of the preceding section, in file order. SHA-1 as MAME lists it
#                     for the set (src/mame/namco/galaga.cpp, the 51xx and 54xx in
#                     namco51.cpp and namco54.cpp).
#                     zip= takes it from another zip in roms/. optional: a missing chip becomes
#                     zeros, with a warning.
#   note <file> <text>  what is lost when an optional chip is missing
#   known <SHA-256> <label>
#                     a finished file the firmware accepts for hardcore. The label has at
#                     most 16 characters, the firmware shows it in its version dialog
#   ra <id>           the game's id on RetroAchievements. A set with known lines needs it and
#                     gets a row in the firmware's game table, a set without achievements
#                     has neither
#   short <text>      the title in the firmware's menus and dialogs, without it the title line
#   dip <id> <value>  a DIP switch the RetroAchievements set expects: the id of a list in the
#                     core's menu_core.xml and one of its values. Any other value shows as
#                     "DIP not default!" in the firmware's RetroAchievements status

set     galaga
title   Galaga (Namco Rev B)
zip     galaga.zip
total   39968
board   1
mirror  5120
# MAME ROT90, the raster turned clockwise
screen  cw

section cpu1        0x0000 16384
chip    gg1_1b.3p   4096 ca7f5da42d4e76fd89bb0b35198a23c01462fbfe
chip    gg1_2b.3m   4096 ab202aa259c3d332ef13dfb8fc8580ce2a5a253d
chip    gg1_3.2m    4096 481f443aea3ed3504ec2f3a6bfcf3cd47e2f8f81
chip    gg1_4b.2l   4096 ddb8b121903646c320939c7d13f4aa4ebb130378
section cpu2        0x4000 4096
chip    gg1_5b.3f   4096 e957a581463caac27bc37ca2e2a90f27e4f62b6f
section cpu3        0x5000 4096
chip    gg1_7b.2c   4096 44c1a04fba3c7c826ff484185cb881b4b22e6657
section bg_graphx   0x6000 4096
chip    gg1_9.4l    4096 62f1279a784ab2f8218c4137c7accda00e6a3490
section sp_graphx   0x7000 8192
chip    gg1_11.4d   4096 e697c180178cabd1d32483c5d8889a40633f7857
chip    gg1_10.4f   4096 c340ed8c25e0979629a9a1730edc762bd72d0cff
# the programs of the two Namco MCUs share one block RAM, the 54xx in the lower half
section cs5xxx      0x9000 2048
chip    54xx.bin    1024 01bdf984a49e8d0cc8761b2cc162fd6434d5afbe zip=namco54.zip optional
note    54xx.bin    the explosion sounds stay silent, everything else works
chip    51xx.bin    1024 50de79e0d6a76bda95ffb02fcce369a79e6abfec zip=namco51.zip
section bg_palette  0x9800 256
chip    prom-4.2n   256  0281de86c236c88739297ff712e0a4f5c8bf8ab9
section sp_palette  0x9900 256
chip    prom-3.1c   256  cdd4bc1013f5c11984fdc4fd10e2d2e27120c1e5
section sound_seq   0x9A00 256
chip    prom-2.5c   256  0c4d0bee858b97632411c440bea6948a74759746
section sound_samp  0x9B00 256
chip    prom-1.1d   256  085ada18c498fdb18ecedef0ea8fe9217edb7b46
section rgb         0x9C00 32
chip    prom-5.5n   32   1a6dea13b4af155d9cb5b999a75d4f1eb9c71346

known   e658893d7e85185e69ae1f8cf91a5a3dc6c2c9706608d36825a5f21734fa619c with the 54xx
known   9ae04f20d36b97680d52b3d130e00dd6a0cfe662eeae43600d9a8e383b4fe3d2 without the 54xx
# RetroAchievements game and the DIP switches its set expects, as the menu's lists keep them:
# 3 lives (L 2) and bonus at 20K/70K (B 2). Most of its conditions read these settings from
# the game's RAM and never fire with other ones.
ra      12138
short   Galaga
dip     L 2
dip     B 2
