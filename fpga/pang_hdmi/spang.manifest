# ROM manifest of Super Pang (World 900914), the second game of the Pang core. The layout is
# pang.manifest's, see there. The keys are MAME's spang_decode. Characters and sprites in the
# pairs of jotego's MRA "Super Pang (World 900914)": spe_02/spe_04 then spj_03/spj_05, and
# spj_10/spj_09. The EEPROM section is MAME's default eeprom-spang.bin, a file of 16-bit words
# with the high byte first, swapped for the 93C46's dump port, which takes the low byte first.
# game_id 1.

set     spang
title   Super Pang (World 900914)
zip     spang.zip
total   1507460
board   9
mirror  18176
screen  upright
# the file make_rom.py builds from roms/spang.zip, the candidate for the firmware's digest list
known   efc3cec0f81ba2daf4986fad0313a3ae6f19aac473fa5dcb89737b68b92b040f MAME spang
kabuki  45670123 45670123 5852 43

section main_data   0x000000 294912 sdram kabuki=data
chip    spe_06.11h  32768   476ba5c95e090663a47d3f98451bf3b79bac7748
chip    spe_07.13h  131072  9d44f7240b56756dcb69d110036b1cb13b1bbc02
