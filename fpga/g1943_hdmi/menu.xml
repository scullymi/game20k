<?xml version="1.0" encoding="utf-8"?>
<!-- 1943 (game20k) configuration for the FPGA Companion. -->
<config name="1943" version="0">
  <actions>
    <!-- game20k: deliberately WITHOUT commands. The Pico answers these five
         buttons itself (menu.c catches them by name) and does not pass them on
         to the core. They must be listed all the same: config_get_action()
         resolves an unknown name to NULL, and the button then does nothing. -->
    <action name="netinfo"/>
    <action name="rainfo"/>
    <action name="verinfo"/>
    <action name="ralist"/>
    <action name="games"/>
    <action name="init">
      <load file="1943.ini"/>
      <set id="R" value="1"/>
    </action>
    <action name="ready">
      <set id="R" value="0"/>
    </action>
    <action name="save">
      <save file="1943.ini"/>
    </action>
    <action name="reset">
      <set id="R" value="1"/>
      <delay ms="10"/>
      <set id="R" value="0"/>
    </action>
    <action name="reset_hide">
      <link action="reset"/>
      <hide/>
    </action>
  </actions>

  <menu label="1943">
    <button label="Games" action="games"/>
    <!-- game20k: the values are the raw DSWA and DSWB bits of MAME 1943.cpp, the wrapper
         only places them. Every list resets: the switches reach the core only in reset.
         The defaults are MAME's. -->
    <menu label="DIP switches">
      <list label="Difficulty:" id="F" default="8" action="reset">
        <listentry label="1 (easy)" value="15"/>
        <listentry label="2" value="14"/>
        <listentry label="3" value="13"/>
        <listentry label="4" value="12"/>
        <listentry label="5" value="11"/>
        <listentry label="6" value="10"/>
        <listentry label="7" value="9"/>
        <listentry label="8 (normal)" value="8"/>
        <listentry label="9" value="7"/>
        <listentry label="10" value="6"/>
        <listentry label="11" value="5"/>
        <listentry label="12" value="4"/>
        <listentry label="13" value="3"/>
        <listentry label="14" value="2"/>
        <listentry label="15" value="1"/>
        <listentry label="16 (hard)" value="0"/>
      </list>
      <list label="Coinage:" id="C" default="7" action="reset">
        <listentry label="1C/1C" value="7"/>
        <listentry label="1C/2C" value="6"/>
        <listentry label="1C/3C" value="5"/>
        <listentry label="1C/4C" value="4"/>
        <listentry label="2C/1C" value="2"/>
        <listentry label="3C/1C" value="1"/>
        <listentry label="4C/1C" value="0"/>
      </list>
    </menu>
    <menu label="Controller">
      <list label="Fire:" id="A" default="1">
        <listentry label="Any" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Bomb:" id="K" default="2">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Coin:" id="N" default="9">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Start 1P:" id="P" default="10">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Start 2P:" id="Q" default="0">
        <listentry label="None" value="0"/>
        <listentry label="1" value="1"/>
        <listentry label="2" value="2"/>
        <listentry label="3" value="3"/>
        <listentry label="4" value="4"/>
        <listentry label="5" value="5"/>
        <listentry label="6" value="6"/>
        <listentry label="7" value="7"/>
        <listentry label="8" value="8"/>
        <listentry label="9" value="9"/>
        <listentry label="10" value="10"/>
        <listentry label="11" value="11"/>
        <listentry label="12" value="12"/>
      </list>
      <list label="Vol -:" id="D" default="0">
        <listentry label="None" value="0"/>
