# ROM manifest of 1943 (Euro). The format is described in the
# head of fpga/galaga_hdmi/galaga.manifest, the section options in fpga/g1942_hdmi/1942.manifest.
# One more option here:
#   gfx_sort=hvvvx    address bits 4:1 sorted HVVV -> VVVH, as JTFRAME's loader does for a
#                     bus with this gfx_sort in mem.yaml (jtframe_dwnld.v, gfx4)
#
# The layout is jotego's (jtcores cores/1943/cfg/mame2mra.toml at 548b87b): maincpu, audiocpu,
# gfx1 and tilerom swapped (reverse), gfx2 and gfx4 16 bits wide in the order 4,0,5,1,6,2,7,3,
# gfx3 16 bits wide and reversed (bm25 on the even byte), mcu at JTFRAME_PROM_START, proms in
# the order 4,7,0,6,1,2,10,3,11,9,8,5, which jt1943_game.v decodes with prog_addr[11:8]. The
# section starts are the bank starts of cfg/macros.def that game_core adds to each bus. The
# map1 and map2 buses (maps) and the obj bus (sprites) are sorted as mem.yaml says.
# Checked against jotego's MRA "1943: The Battle of Midway (Euro)" for jt1943 (MiSTer, MAME
# 0282, jtbin c6deab3): this file without gfx_sort and without the palette section has the
# MRA's asm_md5 1a7e9fe91e24ac1bb2b4a19ecd6dc5d5 (the MRA has no header bytes). So the file
# is the MRA image with maps and sprites sorted as JTFRAME's loader stores them in SDRAM,
# plus the colour PROMs once more for the platform's palette.
# SHA-1 from MAME src/mame/capcom/1943.cpp.

set     1943
title   1943: The Battle of Midway
zip     1943.zip
total   892672
board   6
mirror  8832
# MAME lists 1943 as ROT270, game_core turns the video by 180 degrees with jotego's dip_flip:
# turned clockwise it stands, like 1942
screen  cw

section main        0x00000 163840 sdram
