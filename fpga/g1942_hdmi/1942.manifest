# ROM manifest of 1942 (Revision B): which chips of the MAME set go where in 1942.rom, the
# one file the Companion streams from the SD card into the core. The format is described in
# the head of fpga/galaga_hdmi/galaga.manifest, the section options here are:
#   interleave=16|32  the section's chips in groups of 2 or 4, each group byte by byte
#   swap16            the two bytes of every 16-bit word swapped
#   gfx_sort=hvvvvxx  address bits 6:2 sorted HVVVV -> VVVVH, as JTFRAME's loader does for
#                     a bus with this gfx_sort in mem.yaml (jtframe_dwnld.v, gfx16c)
#   sdram             the section goes to SDRAM bank 2 at its file offset (rom_sdram.sv),
#                     not to the core's write port
#
# The layout is jotego's (jtcores cores/1942/cfg/mame2mra.toml at 0b197caeae15): the regions
# in that order, srb-06 twice so the bank windows of the main CPU line up, gfx1 swapped,
# gfx3 16 bits wide in the order 2,0,3,1 and sorted for the obj bus (mem.yaml), gfx2 32 bits
# wide in the order 0,2,4,4,1,3,5,5. The section starts are his JTFRAME_BA1_START,
# BA2_START, BA3_START and PROM_START, which the core's buses address (game_core.sv). The PROMs come in the order of jt1942_game.v, which
# decodes prog_addr[11:8]: 0..2 the palette, 3 sb-0, 4 sb-4, 5 sb-8, 6 sb-2, 7 sb-3, 9 sb-1.
# Without gfx_sort the file was checked against jotego's Pocket image of 1942 from 2023: all
# bytes equal except the last two PROMs, which that older core version decoded the other way
# round. The file is therefore the MRA image with the sprites sorted as JTFRAME stores them.

set     1942
title   1942 (Revision B)
zip     1942.zip
total   240128
board   3
mirror  9344

section main        0x00000 81920 sdram
chip    srb-03.m3   16384 a089a9bc55fb7d6d0ac53f91b258396d5d62677a
chip    srb-04.m4   16384 856fbb302c9a4ec7850a26ab23dab8467f79bba4
chip    srb-05.m5   16384 35ba1d82bd901940f61d8619273463d02fc0a952
chip    srb-06.m6   8192  2ccc8fc59962d3001fbc10e8d2f20a254a74f251
chip    srb-06.m6   8192  2ccc8fc59962d3001fbc10e8d2f20a254a74f251
chip    srb-07.m7   16384 b588eaf6fddd66ecb2d9832dc197f286f1ccd846
section sound       0x14000 16384 sdram
chip    sr-01.c11   16384 821f85cf157f81117eeaba0c3cf0337eac357e58
# the characters go to block RAM in game_core: their deadline is too short for SDRAM
section chars       0x18000 8192 swap16
chip    sr-02.f2    8192  0dbddadde54a0ab66994c4a8726be05c6ca88a0e
section sprites     0x1A000 65536 sdram interleave=16 gfx_sort=hvvvvxx
chip    sr-16.n1    16384 145b8d5d6c8654cd090955a98f6dd8c8dbafe7c1
chip    sr-14.l1    16384 29f7719f18faad6bd1ec6735cc24e69168361470
chip    sr-17.n2    16384 d4b5d575c021f58f6966df189df94e08c5b3621c
chip    sr-15.l2    16384 136fff6d2a4f48a488fc7c620213761459c3ada0
section tiles       0x2A000 65536 sdram interleave=32
chip    sr-08.a1    8192  5cbd9215fa5ba5a61208b383700adc4428521aed
chip    sr-10.a3    8192  85fdd4c690ed31e6396e3c16aa02140ee7ea2d61
chip    sr-12.a5    8192  ef4dce605eb4dc8035985a415315ec61c21419c6
chip    sr-12.a5    8192  ef4dce605eb4dc8035985a415315ec61c21419c6
chip    sr-09.a2    8192  5b8b685038ec98b781908b92eb7fb9506db68544
chip    sr-11.a4    8192  187c92ef591febdcbd1d42ab850e0cbb62c00873
chip    sr-13.a6    8192  f087d69e49e38cf3107350cde18fcf85a8fa04f0
chip    sr-13.a6    8192  f087d69e49e38cf3107350cde18fcf85a8fa04f0
# the PROMs go to the core's write port, the address inside the section is prog_addr
section proms       0x3A000 2560
chip    sb-5.e8     256   a792f24e5c0c3c4a6b436102e7a98199f878ece1
chip    sb-6.e9     256   f74680a6a987d74b3acb32e6396f20e127874149
chip    sb-7.e10    256   62ad31d31d183cce213b03168daa035083b2f28e
