# ROM manifest of Vulgus (set 1), the second game of the 1942 core: jotego's jt1942 runs it
# with game_id 1. The format is described in the head of fpga/galaga_hdmi/galaga.manifest,
# the section options in 1942.manifest. fill and data are filler bytes and literal bytes.
#
# The layout is jotego's MRA "Vulgus (set 1)" for jt1942 (MiSTer, MAME 0282, jtbin c6deab30):
# the same section starts as 1942, the regions padded with FF, the sprites 16 bits wide in the
# order 2-2n/2-4n, 2-3n/2-5n and sorted for the obj bus, the tiles 32 bits wide. The PROMs in
# the order of jt1942_game.v: 0..2 palette, 3 d1 (characters), 4 c9 (tiles), 5 j2 (sprites),
# 6 and 7 unused, 8 8n, 9 the interrupt PROM.
# Behind 1942's sections comes the header section id: jotego's two header bytes, game_id 1
# and the flip XOR 0, then the screen code. game_core.sv hands the first two to jt1942_game
# as header writes. 1942.rom ends before this section, which makes it the shorter file of
# the board.

set     vulgus
title   Vulgus (set 1)
zip     vulgus.zip
total   240384
board   3
mirror  9344
# turned clockwise like 1942, seen in the simulation
screen  cw

section main        0x00000 81920 sdram
chip    vulgus.002  8192  48072aaa1f2603b6301d7542cc3df10ead2847bb
chip    vulgus.003  8192  14dda82b90f9c3a309561a73c300cb54b5fca77d
chip    vulgus.004  8192  f3f685955fc42f238909dcdb5edc4c117e5543db
chip    vulgus.005  8192  6bc9dda7dbbbef82e9f61c9d5cf1555e5290b249
chip    1-8n.bin    8192  6f28d143e984d3d6af3114702ec27d6e878cc35f
fill    40960
section sound       0x14000 16384 sdram
chip    1-11c.bin   8192  b58fb1ea7e30018102ee420d52a1597615412eb1
fill    8192
section chars       0x18000 8192 swap16
chip    1-3d.bin    8192  c572b4a26f12013f5f6463b79ba9cbee4c474bbe
section sprites     0x1A000 65536 sdram interleave=16 gfx_sort=hvvvvxx
chip    2-2n.bin    8192  85bf67ce4d60b260767ba5fe9b9777f857937fe3
chip    2-4n.bin    8192  3f7bb4658d2126576a0f8f46f2c947eec1cd231a
chip    2-3n.bin    8192  7b7df89398bf83ace1a8c216ca8526beae90972d
chip    2-5n.bin    8192  8b69b9cd6db37db94a00da8712413055a631186a
fill    32768
section tiles       0x2A000 65536 sdram interleave=32
chip    2-2a.bin    8192  f9f0d05475ae4c554552a71bc2f60e02b1442eb1
chip    2-4a.bin    8192  645666895127aededfa7872b20b7725948a9c462
chip    2-6a.bin    8192  987a4844c4568a088932f43a3aff847e6d6b4860
chip    2-6a.bin    8192  987a4844c4568a088932f43a3aff847e6d6b4860
chip    2-3a.bin    8192  c4c633a909526308de4ad83e8ca449fa71eb3cb5
chip    2-5a.bin    8192  c935176f8a9bce0f74ff466e10c23ff6557f85ec
chip    2-7a.bin    8192  dbced07d4a886ed9ad3302aaa37bc02c599ee132
chip    2-7a.bin    8192  dbced07d4a886ed9ad3302aaa37bc02c599ee132
section proms       0x3A000 2560
chip    e8.bin      256   218c1b404b4b5b06f06e04143872f6758f83f266
chip    e9.bin      256   d597097afc53fef752b2530d2de04e5aabb664b4
chip    e10.bin     256   c719892f0c6d8c82ee2ff41bfe74b67648f5b4f5
chip    d1.bin      256   6c1e8572a4c7b4825b89fc9549265be7c8f17788
chip    c9.bin      256   5a2110e97e82c087999ee4e5adf32d7fa06a3dfb
chip    j2.bin      256   7d76e1ff75466e190bc2e07ff3ffb45034f838cd
chip    e8.bin      256   218c1b404b4b5b06f06e04143872f6758f83f266
chip    e8.bin      256   218c1b404b4b5b06f06e04143872f6758f83f266
chip    82s129.8n   256   aee37d6cdc36acf0f11ff5f93e7b16e4b12f6c39
chip    82s126.9k   256   10b258e32813cfa3a853cbd146657b11c08cb770
# game_id 1 (Vulgus), flip XOR 0, byte 2 the screen code
section id          0x3AA00 256 header
data    01 00
fill    254 0
