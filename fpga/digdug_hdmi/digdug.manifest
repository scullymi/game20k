# ROM manifest of Dig Dug (rev 2): which chips of the MAME set go where in digdug.rom. The
# format is described in the head of fpga/galaga_hdmi/galaga.manifest.
#
# The layout is the download image of MiSTer-X's core (MRA "Dig Dug (Rev 2)"): program of
# CPU0, sprites, programs of CPU1 and CPU2, playfield map, background and character graphics,
# then the wave, sprite lookup, background lookup and palette PROMs. The program of CPU0 goes
# to SDRAM, the rest to the core's write port, where game_core adds 0x4000 to the section
# address. 136007.109 (sound timing) is not used by the board, as in MAME. The programs of the
# 51XX and 53XX, which the core runs on its own MB88, come from namco51.zip and namco53.zip
# and go to 0xE000. SHA-1 from MAME 0.289 -listxml digdug (src/mame/namco/galaga.cpp, the
# customs in namco51.cpp and namco53.cpp).

set     digdug
title   Dig Dug (rev 2)
zip     digdug.zip
total   58144
board   8
mirror  5120
# MAME ROT90: turned clockwise it stands
screen  cw
# the file make_rom.py builds from roms/digdug.zip, namco51.zip and namco53.zip, the candidate
# for the firmware's digest list
known   322bcd78526311d9005667d494064af51922ceeb80fabf076e9ca788bee4a678 MAME digdug
# RetroAchievements game and the DIP switches its set expects: 3 lives (L 2), bonus at 10K,
# 40K and every 40K (B 4) and no continue (O 1), one of its achievements checks these.
ra      12091
short   Dig Dug
dip     L 2
dip     B 4
dip     O 1

section main        0x0000 16384 sdram
chip    dd1a.1      4096 86689980410b9429cd7582c7a76342721c87d030
chip    dd1a.2      4096 fde17785df21956d6fd06bcfe675c392dadb1524
chip    dd1a.3      4096 57b8a5777f8bb9773caf0cafe5408c8b9768cb25
chip    dd1a.4      4096 b0a615fe4a5c8742c1e4ef234ef34c369d2723b9
section mcu         0x4000 2048
chip    51xx.bin    1024 50de79e0d6a76bda95ffb02fcce369a79e6abfec zip=namco51.zip
chip    53xx.bin    1024 758d8583d658e4f1df93184009d86c3eb8713899 zip=namco53.zip
section core        0x4800 39712
chip    dd1.15      4096 4700c63f4f680cb8ab8c44e6f3e1712aabd5daa4
chip    dd1.14      4096 3e435c1afb2e44487cd7ba28a93ada2e5ccbb86d
chip    dd1.13      4096 578bd839f9218c3cf4feee1223a461144e455df8
chip    dd1.12      4096 bd79e39e8a572d2b5c205e6de27ca23e43ec9f51
chip    dd1a.5      4096 c16144de7633595ddc1450ddce379f48e7b2195a
chip    dd1a.6      4096 89b2ead7e478e119d33bfd67376cdf28f83de67a
chip    dd1.7       4096 2b9b74f56aa7939d9d47cf29497ae11f10d78598
chip    dd1.10b     4096 317c48818992f757b1bd0e3997fa99937f81b52c
chip    dd1.11      4096 57f1e8f5171d13f9f76bd091d81b4423b59f6b42
chip    dd1.9       2048 0aa63300c2cb887196de590aceb98f3cf06fead4
chip    136007.110  256  085ada18c498fdb18ecedef0ea8fe9217edb7b46
chip    136007.111  256  7ea149e8eb36920c3b84984b5ce623729d492fd3
chip    136007.112  256  a294cc4da846eb702d61678396bfcbc87d30ea95
chip    136007.113  32   91a5852a15d4672c29fdcbae75921794651f960c
